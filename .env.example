# Copy this file to .env and fill it in before running on a real server.
# Without a .env file, docker compose uses safe-for-a-laptop development defaults.

# production: no demo accounts, no test helpers, generic error messages.
APP_ENV=production

# At least 32 random characters. Used to protect Aadhaar duplicate checks and OJT signature references.
# Generate one with:  php -r "echo bin2hex(random_bytes(32));"   or   openssl rand -hex 32
# Never change it after real data exists (duplicate checks would stop matching).
APP_SECRET=

# PostgreSQL
DB_NAME=kaac
DB_USER=kaac
DB_PASS=

# Password for the first administrator account ('admin'), used only when the database is created.
# At least 10 characters with letters and numbers. Change it again after first login.
ADMIN_PASSWORD=

# Create the eight demo officer accounts (development only). Keep false in production.
DEMO_USERS=false

# When the portal runs behind an HTTPS reverse proxy, list the proxy's IP address or range here
# (comma-separated, CIDR allowed) so rate limits apply per visitor, not to the proxy. Example: 172.16.0.0/12
TRUSTED_PROXIES=

# Ports on the host machine.
APP_PORT=8080
DB_HOST_PORT=5433
